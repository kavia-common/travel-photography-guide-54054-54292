# PUBLIC_INTERFACE
# Environment variables required by the WebFrontend.
# Configure these via deployment orchestrator; do not commit a real .env file.

# Base URL of the backend API (e.g., https://api.example.com)
REACT_APP_API_BASE_URL=https://api.example.com

# Optional WebSocket URL for real-time notifications (e.g., wss://api.example.com/ws/notifications)
REACT_APP_WS_URL=wss://api.example.com/ws/notifications

# Site URL for OAuth redirect if needed by external providers (used by backend)
REACT_APP_SITE_URL=https://web.example.com
